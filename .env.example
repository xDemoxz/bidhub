# Copia este archivo a .env y completa los valores. NUNCA subas el .env real.

# Cadena de conexión de PostgreSQL.
# Supabase: Project Settings > Database > Connection string > "Session pooler"
# (puerto 5432). Sirve para migraciones y para la app. Reemplaza [PASSWORD].
# Local: postgresql://postgres:postgres@localhost:5432/bidhub
DATABASE_URL=

# Secretos para firmar los JWT. Deben ser distintos entre sí y tener 32+ caracteres.
# Genera cada uno con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Duración de los tokens. Formato: número + unidad (s, m, h, d).
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Credenciales del administrador que crea el seed (cámbialas en producción).
SEED_ADMIN_EMAIL=admin@bidhub.com
SEED_ADMIN_PASSWORD=Admin1234!
